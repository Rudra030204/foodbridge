# Copy to .env (backend reads backend/.env or real environment variables)
DATABASE_URL=postgresql+psycopg2://foodbridge:foodbridge@db:5432/foodbridge
# SQLite fallback (no Docker):  DATABASE_URL=sqlite:///./foodbridge.db
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIME_SCALE=1
SCHEDULER_ENABLED=true
